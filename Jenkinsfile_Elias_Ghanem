// Runs commands with sh on Linux/macOS agents and bat on Windows agents
def run(String unixCmd, String winCmd) {
    if (isUnix()) {
        sh unixCmd
    } else {
        bat winCmd
    }
}

// Windows path to the venv activation script (single quotes avoid GString escaping issues)
WIN_ACTIVATE = 'venv\\Scripts\\activate.bat'

pipeline {
    agent any
    environment {
        VIRTUAL_ENV = 'venv'
    }
    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        run("python3 -m venv ${VIRTUAL_ENV}", "python -m venv ${VIRTUAL_ENV}")
                    }
                    run(". ${VIRTUAL_ENV}/bin/activate && pip install -r requirements.txt",
                        "call " + WIN_ACTIVATE + " && python -m pip install -r requirements.txt")
                }
            }
        }
        stage('Lint') {
            steps {
                script {
                    run(". ${VIRTUAL_ENV}/bin/activate && flake8 app.py",
                        "call " + WIN_ACTIVATE + " && flake8 app.py")
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    run(". ${VIRTUAL_ENV}/bin/activate && pytest",
                        "call " + WIN_ACTIVATE + " && pytest")
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    // Deployment logic, e.g., pushing to a remote server
                    echo "Deploying application..."
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
